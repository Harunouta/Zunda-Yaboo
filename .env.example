# Example environment — safe to commit. Copy to `.env` locally (gitignored).

# GUI default / compose: sim talks to the gateway on :4000.
# The gateway talks to LM Studio on the host :1234.
LM_STUDIO_HOST=llm-gateway
LM_STUDIO_PORT=4000
GW_LMSTUDIO_HOST=host.docker.internal
GW_LMSTUDIO_PORT=1234
LLM_PROVIDER=lmstudio
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
RULER_MODEL=qwen3.6-27b
CROWD_MODEL=google/gemma-4-e4b
MASCOT_MODEL=qwen2.5-7b-instruct
OPINION_MODEL=qwen2.5-7b-instruct
AGRI_MODEL=qwen2.5-7b-instruct
ZUNDA_AI_DIR=/models
# Host bind for docker-compose / republish script (no drive letter in git)
# ZUNDA_AI_HOST=./models
LM_TIMEOUT_SEC=180
LM_MAX_TOKENS=1024
