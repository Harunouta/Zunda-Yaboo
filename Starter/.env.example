# Copy to Starter/.env and edit if needed (optional).
# cp Starter/.env.example Starter/.env

# Host ports
GW_HOST_PORT=4000
VIEWER_HOST_PORT=8765
HTTP_HOST_PORT=8080

# Gateway → host LM Studio
GW_LMSTUDIO_HOST=host.docker.internal
GW_LMSTUDIO_PORT=1234

# Gateway specialist model ids (must match LM Studio after download)
GW_POLICY_MODEL=qwen3-4b-instruct-2507
GW_IDS_MODEL=qwen2.5-7b-instruct
GW_PROSE_MODEL=qwen2.5-14b-instruct
GW_CRISIS_MODEL=qwen3.6-27b
GW_CRISIS_USE_27B=1

# Sim container → gateway (compose service name)
LM_STUDIO_HOST=llm-gateway
LM_STUDIO_PORT=4000
RULER_MODEL=qwen3.6-27b
CROWD_MODEL=qwen2.5-7b-instruct
CROWD_FALLBACK_MODEL=google/gemma-4-e4b

# Host folder for optional GGUF hints (weights NOT in git)
# ZUNDA_AI_HOST=../models
